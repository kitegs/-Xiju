# V2 本地开发默认使用 backend/data/aibi-v2.db
# AIBI_DATA_DIR=./data
# AIBI_MAX_UPLOAD_BYTES=52428800
# 默认禁用：绝不在宿主机执行 LLM 生成代码。
# 启用前需要准备无网络、只读数据挂载、资源受限的专用 Docker sandbox。
# AIBI_SANDBOX_ENABLED=false
# AIBI_SANDBOX_IMAGE=
# AIBI_CUBE_API_URL=http://localhost:4000/cubejs-api/v1
# AIBI_SUPERSET_URL=http://localhost:8088
